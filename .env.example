# Copy to .env.local for local development. NEVER commit real values.
# In staging/production set these as platform secrets/variables, not in a file.
#
# Notes:
# - Pages that are statically rendered (landing page, legal pages) read APP_URL, BRAND_* and
#   TURNSTILE_SITE_KEY at BUILD time. Changing them requires a rebuild.
# - Server-only values (DATABASE_URL, TURNSTILE_SECRET_KEY, ...) are read at runtime.

# --- Runtime -------------------------------------------------------------------------------
# development | test | staging | production. Production/staging enable extra safety checks
# (real brand details required, Cloudflare test keys refused, https APP_URL required).
APP_ENV=development
# Canonical public origin, no trailing slash.
APP_URL=http://localhost:3000
# Extra origins (comma separated) allowed to call /api/v1 from a browser. APP_URL is always allowed.
ALLOWED_ORIGINS=
# How to find the real client IP. none = use the socket only (never trust forwarded headers).
# cloudflare = trust CF-Connecting-IP (ONLY when the origin cannot be reached except via Cloudflare).
# forwarded = trust the left-most X-Forwarded-For entry appended by a proxy you control.
TRUST_PROXY=none
LOG_LEVEL=info

# --- Database --------------------------------------------------------------------------------
# App runtime connection. In staging/production use the least-privilege role (leadgen_app),
# NOT the owner/superuser. See docs/04-security-and-privacy.md.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/leadgen_dev
# Optional: connection used only for migrations/seeds (owner role). Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# disable | require | verify-full
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# Admin connection used by the test-suite to create throw-away databases (never point at real data).
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres

# --- Cloudflare Turnstile --------------------------------------------------------------------
# These are Cloudflare's PUBLIC dummy keys: the widget always passes. They are refused when
# APP_ENV is staging/production. Create real keys at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Operator inbox access (stage 2) ----------------------------------------------------------------
# The inbox (/admin) shows consumers' phone numbers, so it is reachable only with a valid Cloudflare Access
# token (verified IN THE APP, not just at the edge) for an allowlisted email. Required in staging/production;
# leave unset locally and use ADMIN_DEV_EMAIL instead.
#   Team domain: Zero Trust dashboard > Settings > Custom pages (the <team>.cloudflareaccess.com name)
#   Audience tag: Zero Trust > Access > Applications > your admin application > Overview > "Application Audience (AUD) Tag"
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Comma-separated. Anyone not listed is refused even if Access let them through.
ADMIN_ALLOWED_EMAILS=
# Comma-separated, and implicitly allowed in. Owners can do everything staff can, plus ERASE a person (stage 3).
# Required in staging/production so someone can action an erasure request. Locally, the dev operator is an owner.
ADMIN_OWNER_EMAILS=
# Secret for the keyed hashes of the "do not contact again" list (stage 3): at least 32 random characters, e.g.
#   openssl rand -base64 48
# Required in staging/production, on BOTH the web service and the worker (the router checks suppressions with it: it must be the
# same value). NEVER ROTATE IT: every existing suppression would stop matching. Back it up
# separately from the database (a password manager the owner controls). Unset locally: a fixed development key is used.
PRIVACY_HASH_KEY=
# Where operators open the inbox (the link in alert emails), e.g. https://admin.example.com. Defaults to APP_URL.
ADMIN_BASE_URL=
# DEVELOPMENT ONLY (`npm run dev`): act as this operator without Cloudflare Access. Refused in staging/production.
ADMIN_DEV_EMAIL=operator@example.test

# --- Email (stage 2 alerts and stage 5 deliveries, sent by the worker; stage 6 sign-in links, sent by the web service) ---
# console = print the email instead of sending it (development/test only; refused in staging/production).
# resend  = send through Resend (https://resend.com): create an API key and verify your sending domain.
# Set the same three values (provider, key, from) on the worker AND the web service.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# "Display Name <address@your-verified-domain>"
EMAIL_FROM=
# Who receives alerts. Comma-separated. Required in staging/production. (Dev default: operator@example.test)
OPERATOR_ALERT_EMAILS=
# One reminder email for a lead still unhandled after this many minutes.
ALERT_REMINDER_MINUTES=15
# Timing knobs (seconds / milliseconds). The defaults are the tested ones; leave unset in production.
# WORKER_LEASE_SECONDS=60  WORKER_POLL_MS=5000  WORKER_RECONCILE_MS=15000  WORKER_GRACE_SECONDS=60

# --- Error reporting ----------------------------------------------------------------------------------
# Sentry DSN (web and worker). Required in production. Events are scrubbed of personal data before sending
# (src/lib/error-reporting.ts); leave empty to disable.
SENTRY_DSN=

# --- Brand and legal identity (REQUIRED in production, shown on the site and in the consent text) --
BRAND_NAME=RoofQuote Local
BRAND_LEGAL_NAME=RoofQuote Local Ltd (placeholder)
BRAND_COMPANY_NUMBER=00000000 (placeholder)
BRAND_REGISTERED_ADDRESS=1 Placeholder Street, Orpington, Kent, BR0 0XX (placeholder)
BRAND_ICO_REGISTRATION=ZA000000 (placeholder)
BRAND_PRIVACY_EMAIL=privacy@example.com
# Set to true ONLY after a qualified person has reviewed the consent wording (src/config/consent.ts),
# the privacy notice and the terms. Production refuses to start without it.
LEGAL_TEXT_REVIEWED=false
# Human-readable launch footprint shown on the landing page. Must match db/seeds/service-areas.ts.
BRAND_LAUNCH_REGION=Orpington, Bromley, Sevenoaks and North Kent

# --- Delivery to businesses (stage 5) ----------------------------------------------------------------------
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts each business's webhook signing secret. The SAME value on the web
# service and the worker. Without it the webhook channel is unavailable. Losing it loses the secrets: back it up apart from the database.
DELIVERY_SECRETS_KEY=
# Text messages (worker). All four or none. Use an API key, not the account auth token.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
# Verifies Twilio's delivery reports (web service): POST <APP_URL>/api/webhooks/twilio. Without it the endpoint answers 503.
TWILIO_AUTH_TOKEN=
